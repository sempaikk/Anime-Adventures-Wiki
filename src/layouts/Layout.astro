---
import '../styles/global.css';
import '../styles/content.css';
import '../styles/futuristic.css';
import { wiki, articleUrl } from '../lib/wiki';
const { title = 'Adventures Wiki — Anime Adventures', description = 'Personagens, evoluções, itens e guias de Anime Adventures. Explore informações do jogo com organização e artes originais.', active = 'inicio' } = Astro.props;
const nav = [
  ['inicio','Início','/'], ['personagens','Personagens','/personagens/'],
  ['biblioteca','Biblioteca','/biblioteca/'], ['evolution','Evoluções',articleUrl('Evolution')],
  ['items','Itens e recursos',articleUrl('Items')], ['traits','Traits',articleUrl('Traits')],
  ['modes','Modos de jogo','/biblioteca/?tipo=mode'], ['tiers','Tier lists',articleUrl('Tier Lists')],
  ['map','Mapa do jogo','/mapa/'], ['updates','Atualizações','/atualizacoes/'],
];
const invite='https://discord.com/oauth2/authorize?client_id=1561527465657114644&scope=bot+applications.commands&permissions=378494110720&integration_type=0';
---
<!doctype html><html lang="pt-BR" data-theme="dark"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/><meta name="color-scheme" content="dark light"/>
  <meta name="robots" content="noindex,follow"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
  <meta name="theme-color" content="#090a0c"/><title>{title}</title>
  <link rel="icon" href={wiki.branding.image} type="image/png"/>
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('aa-theme')||'dark'}catch{}</script>
</head><body id="top">
<a class="skip-link" href="#main">Ir para o conteúdo</a>
<header class="site-header"><a class="brand" href="/" aria-label="Adventures Wiki — início"><span class="brand-emblem"><img src={wiki.branding.image} alt="" width="40" height="40"/></span><span>ADVENTURES<span class="brand-sub">WIKI</span></span></a><a class="preview-label" href="/sobre/" title="Conteúdo e apresentação em revisão">PRÉVIA</a>
  <nav class="top-nav" aria-label="Navegação principal"><a href="/personagens/" class:list={{selected:active==='personagens'}}>Personagens</a><a href="/biblioteca/" class:list={{selected:active==='biblioteca'}}>Explorar a wiki</a><a class="install-link" href={invite} target="_blank" rel="noopener noreferrer">Adicionar ao Discord <span class="external-arrow" aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a></nav>
  <div class="header-actions"><button class="search-trigger" data-search-open aria-label="Pesquisar na wiki"><span>Pesquisar na wiki</span><kbd>Ctrl K</kbd><span class="search-mark" aria-hidden="true">⌕</span></button><button class="theme-toggle square-button" aria-label="Ativar tema claro" title="Alternar tema" data-theme-toggle><span class="theme-symbol" aria-hidden="true">◐</span></button><button class="menu-toggle square-button" aria-label="Abrir navegação" aria-expanded="false" aria-controls="side-nav" data-menu-toggle><span aria-hidden="true">☰</span></button></div>
</header>
<div class="site-shell"><aside class="sidebar" id="side-nav"><div class="sidebar-top"><span class="eyebrow">ANIME ADVENTURES</span><span class="sidebar-coordinate">WIKI</span></div>
  <nav aria-label="Explorar"><span class="nav-label">EXPLORAR</span>{nav.map(([key,label,href])=><a href={href} class:list={['side-link',{active:active===key}]} aria-current={active===key?'page':undefined}>{label}<span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a>)}</nav>
  <div class="sidebar-divider"></div><nav aria-label="Sua coleção"><span class="nav-label">SUA COLEÇÃO</span><a class="side-link" href="/favoritos/">Favoritos<span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a><a class:list={['side-link',{active:active==='conta'}]} href="/conta/" data-account-entry hidden>Sua conta<span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a><a class="side-link" href={invite} target="_blank" rel="noopener noreferrer">Adicionar o bot<span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a></nav>
  <div class="sidebar-bottom"><span>Uma wiki da comunidade.<br/><small>Conheça. Planeje. Evolua.</small></span></div>
</aside><div class="page-wrapper"><main id="main"><slot/></main><footer class="site-footer"><div><strong>ADVENTURES WIKI</strong><p>O universo do jogo, organizado para você.</p></div><div><a href="/sobre/">Sobre e fontes</a><span>Projeto independente da comunidade.</span><small>Textos da Anime Adventures Wiki sob <a href="https://www.fandom.com/licensing" target="_blank" rel="noopener noreferrer">CC-BY-SA</a>. Artes com créditos nas fontes.</small></div><a href="#top" class="back-top" aria-label="Voltar ao topo">↑</a></footer></div></div>
<div class="nav-scrim" data-menu-close></div>
<dialog id="search-dialog" aria-labelledby="search-title"><div class="search-head"><h2 id="search-title">O que você quer descobrir?</h2><button class="square-button" data-search-close aria-label="Fechar busca">×</button></div><label class="sr-only" for="global-search">Pesquisar personagens e artigos</label><input id="global-search" type="search" placeholder="Busque personagens, itens, modos…" autocomplete="off"/><div class="search-results" id="global-results" aria-live="polite"></div><div class="search-foot"><span>Busca nos artigos e nomes anteriores</span><span><kbd>Esc</kbd> para fechar</span></div></dialog>
<div class="toast" role="status" aria-live="polite"></div>
<script src="../scripts/client.ts"></script>
</body></html>
