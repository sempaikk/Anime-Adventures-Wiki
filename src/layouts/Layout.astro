---
import '../styles/global.css';
import '../styles/content.css';
import '../styles/adventures.css';
import '../styles/interface.css';
import '../styles/tools.css';
import { wiki, articleUrl, art, catalog } from '../lib/wiki';
import { channels, botInvite } from '../lib/community';
import NavigationMotion from '../components/NavigationMotion.astro';
import ComparisonTray from '../components/ComparisonTray.astro';
const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const { title = 'Adventures Wiki — Anime Adventures', description = 'Personagens, itens, guias e informações sobre Anime Adventures. Wiki independente da comunidade.', active = isHome ? 'inicio' : '' } = Astro.props;
const pages = [
  ['inicio','Início','/'], ['biblioteca','Biblioteca','/biblioteca/'],
  ['comparar','Comparar personagens','/comparar/'],
  ['tiers','Tier lists',articleUrl('Tier Lists')], ['map','Mapa do lobby','/mapa/'],
  ['comunidade','Jogo e comunidade','/comunidade/'], ['updates','Atualizações','/atualizacoes/'],
];
const game = [
  ['personagens','Personagens','/personagens/','/art/game-Units_Icon.png'],
  ['items','Itens',articleUrl('Items'),'/art/game-Items_Icon.png'],
  ['evolution','Evoluções',articleUrl('Evolution'),art('ui-evolution')],
  ['traits','Traits',articleUrl('Traits'),art('ui-traits')],
  ['modes','Modos de jogo','/biblioteca/?tipo=mode',catalog.fileImage("Demon Leader's Portal.png")?.url],
];
const themes = [['adventures','Adventures','Cores do jogo'],['dark','Escuro','Contraste suave'],['light','Claro','Fundo claro']];
---
<!doctype html><html lang="pt-BR" data-theme="adventures"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/><meta name="color-scheme" content="dark light"/>
  <meta name="robots" content="noindex,follow"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
  <meta property="og:image" content={new URL('/art/branding-release.png', Astro.site).href}/>
  <meta name="theme-color" content="#10142c"/><title>{title}</title>
  <link rel="icon" href={wiki.branding.image} type="image/png"/>
  <script is:inline>try{const t=localStorage.getItem('aa-theme');document.documentElement.dataset.theme=['adventures','dark','light'].includes(t)?t:'adventures'}catch{}</script>
  <NavigationMotion/>
</head><body id="top" class:list={{'page-home':isHome}}>
<a class="skip-link" href="#main">Ir para o conteúdo</a>
<div class="navigation-progress" aria-hidden="true"></div>
<header class="site-header">
  <a class="brand" href="/" aria-label="Adventures Wiki — início"><span class="brand-emblem"><img src={wiki.branding.image} alt="" width="42" height="42"/></span><span>ADVENTURES<span class="brand-sub">WIKI</span></span></a>
  <button class="search-trigger" data-search-open aria-label="Pesquisar na wiki"><span class="search-mark" aria-hidden="true"></span><span>Pesquisar na wiki</span><kbd>Ctrl K</kbd></button>
  <div class="header-actions">
    <details class="theme-menu"><summary class="square-button" aria-label="Escolher tema" title="Escolher tema"><span class="theme-symbol" aria-hidden="true">◐</span></summary><div class="theme-options"><span class="eyebrow">TEMA</span>{themes.map(([key,name,detail])=><button type="button" data-set-theme={key} aria-pressed={key==='adventures'}><span class={`theme-swatch theme-swatch-${key}`} aria-hidden="true"></span><span><strong>{name}</strong><small>{detail}</small></span><span class="theme-check" aria-hidden="true">✓</span></button>)}</div></details>
    <a class="header-account" href="/conta/" data-account-link><span class="account-avatar-placeholder" aria-hidden="true"></span><span data-account-label>Sua conta</span></a>
    <button class="menu-toggle square-button" aria-label="Abrir navegação" aria-expanded="false" aria-controls="side-nav" data-menu-toggle><span aria-hidden="true">☰</span></button>
  </div>
</header>
<div class="site-shell"><aside class="sidebar" id="side-nav">
  <nav aria-label="Navegação principal"><span class="nav-label">WIKI</span>{pages.map(([key,label,href])=><a href={href} class:list={['side-link',{active:active===key}]} aria-current={active===key?'page':undefined}><span class="side-label">{label}</span><span class="side-indicator" aria-hidden="true">›</span></a>)}</nav>
  <details class="side-section" open={game.some(([key])=>key===active)}><summary>Conteúdos do jogo<span aria-hidden="true">＋</span></summary><nav aria-label="Conteúdos do jogo">{game.map(([key,label,href,icon])=><a href={href} class:list={['side-link','side-game-link',{active:active===key}]} aria-current={active===key?'page':undefined}><img src={icon} alt="" width="25" height="25"/><span class="side-label">{label}</span><span class="side-indicator" aria-hidden="true">›</span></a>)}</nav></details>
  <details class="side-section" open={['favoritos','conta'].includes(active)}><summary>Sua conta<span aria-hidden="true">＋</span></summary><nav aria-label="Sua conta"><a class:list={['side-link',{active:active==='favoritos'}]} href="/favoritos/" aria-current={active==='favoritos'?'page':undefined}>Favoritos</a><a class:list={['side-link',{active:active==='conta'}]} href="/conta/" aria-current={active==='conta'?'page':undefined}>Entrar ou gerenciar conta</a></nav></details>
  <div class="sidebar-bottom"><a class="sidebar-install" href={botInvite} target="_blank" rel="noopener noreferrer">Adicionar o bot <i class="arrow-diagonal" aria-hidden="true"></i></a><a href="/sobre/">Sobre, fontes e créditos</a></div>
</aside><div class="page-wrapper"><main id="main"><slot/></main>
<footer class="site-footer"><div><strong>ADVENTURES WIKI</strong><p>Informações sobre Anime Adventures.</p></div><div class="footer-links"><a href="/sobre/">Sobre e fontes</a>{channels.map(channel=><a href={channel.url} target="_blank" rel="noopener noreferrer">{channel.platform} <i class="arrow-diagonal" aria-hidden="true"></i></a>)}</div><small>Projeto independente. Textos da Anime Adventures Wiki sob <a href="https://www.fandom.com/licensing" target="_blank" rel="noopener noreferrer">CC-BY-SA</a>. Artes com créditos nas fontes.</small><a href="#top" class="back-top" aria-label="Voltar ao topo">↑</a></footer></div></div>
<nav class="mobile-dock" aria-label="Navegação rápida"><a href="/" aria-current={active==='inicio'?'page':undefined}>Início</a><a href="/biblioteca/" aria-current={active==='biblioteca'?'page':undefined}>Biblioteca</a><a href="/favoritos/" aria-current={active==='favoritos'?'page':undefined}>Favoritos</a><a href="/conta/" aria-current={active==='conta'?'page':undefined}>Conta</a></nav>
<div class="nav-scrim" data-menu-close></div>
<dialog id="search-dialog" aria-labelledby="search-title"><div class="search-head"><div><span class="eyebrow">BUSCA</span><h2 id="search-title">Pesquisar na wiki</h2></div><button class="square-button" data-search-close aria-label="Fechar busca">×</button></div><label class="sr-only" for="global-search">Pesquisar personagens e artigos</label><input id="global-search" type="search" placeholder="Personagens, itens, modos…" autocomplete="off"/><div class="search-results" id="global-results" aria-live="polite"></div><div class="search-foot"><span>Você também pode pesquisar por nomes anteriores.</span><span><kbd>Esc</kbd> para fechar</span></div></dialog>
<dialog class="unit-preview" id="unit-preview" aria-labelledby="preview-name"><button class="square-button preview-close" data-preview-close aria-label="Fechar ficha rápida">×</button><div class="preview-art"><span class="eyebrow">FICHA RÁPIDA</span><img data-preview-image alt="" width="300" height="300"/><span class="preview-orbit" aria-hidden="true"></span></div><div class="preview-copy"><span class="rarity-label" data-preview-rarity></span><h2 id="preview-name">Carregando personagem…</h2><p data-preview-aliases></p><dl class="unit-facts" data-preview-facts></dl><p class="preview-notice" data-preview-message role="status"></p><div class="preview-actions"><a class="button button-primary" data-preview-article href="/personagens/">Ver ficha completa <span>→</span></a><button class="button button-outline" data-preview-save disabled>Salvar</button><button type="button" class="button button-outline" data-preview-compare disabled>Comparar</button></div></div></dialog>
<div class="toast" role="status" aria-live="polite"></div>
<ComparisonTray/>
<script src="../scripts/client.ts"></script>
</body></html>
