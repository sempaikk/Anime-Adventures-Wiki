---
import Icon from './Icon.astro';
---
<aside class="comparison-tray" id="comparison-tray" aria-label="Personagens para comparar" hidden>
  <div class="comparison-tray-copy"><strong data-comparison-count></strong><div class="comparison-tray-units" data-comparison-units></div></div>
  <div class="comparison-tray-actions"><button type="button" class="plain-button" data-comparison-clear>Limpar</button><a class="button button-primary" data-comparison-link href="/comparar/">Comparar <span aria-hidden="true"><Icon name="arrow"/></span></a></div>
</aside>
<p class="tool-status sr-only" data-comparison-status role="status" aria-live="polite"></p>
