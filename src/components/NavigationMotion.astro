<script is:inline>
(() => {
  const root=document.documentElement,reduced=matchMedia('(prefers-reduced-motion: reduce)');
  let navigating=false,timer=0,exitAnimations=[],transientPreference=null,navigationVersion=0;
  function preference(){if(transientPreference)return transientPreference;try{return localStorage.getItem('aa-motion')}catch{return null}}
  function enabled(){const value=preference();return value==='on'||(value!=='off'&&!reduced.matches)}
  function sync(){
    root.dataset.motion=enabled()?'on':'off';
    document.querySelectorAll('[data-navigation-motion]').forEach(input=>input.checked=enabled());
    if(!enabled())root.removeAttribute('data-page-entry');
    document.dispatchEvent(new CustomEvent('aa:motion-change'));
  }
  sync();
  // A native transition may be skipped by a rapid navigation, BFCache or a
  // preference change. Consume both promises; cancellation is not a page error.
  for(const name of ['pagereveal','pageswap'])addEventListener(name,event=>{
    const transition=event.viewTransition;
    if(!transition)return;
    transition.ready.catch(()=>{});transition.finished.catch(()=>{});transition.updateCallbackDone?.catch(()=>{});
    if(!enabled())transition.skipTransition();
  });
  if(enabled())root.dataset.pageEntry=performance.getEntriesByType('navigation')[0]?.type==='back_forward'?'back':'forward';
  reduced.addEventListener('change',sync);
  addEventListener('storage',event=>{if(event.key==='aa-motion'||event.key===null){transientPreference=null;sync()}});
  document.addEventListener('DOMContentLoaded',()=>{
    for(const input of document.querySelectorAll('[data-navigation-motion]')){
      input.checked=enabled();input.addEventListener('change',()=>{
        transientPreference=input.checked?'on':'off';try{localStorage.setItem('aa-motion',transientPreference)}catch{}
        sync();
      });
    }
  });
  addEventListener('pageshow',event=>{
    navigationVersion++;navigating=false;clearTimeout(timer);root.removeAttribute('data-navigating');
    for(const animation of exitAnimations)animation.cancel();exitAnimations=[];
    if(event.persisted&&enabled()){
      root.removeAttribute('data-page-entry');
      requestAnimationFrame(()=>root.dataset.pageEntry='back');
    }
  });
  addEventListener('pagehide',()=>{navigationVersion++;clearTimeout(timer)});
  document.addEventListener('click',event=>{
    if(event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
    const anchor=event.target instanceof Element?event.target.closest('a[href]'):null;
    if(!anchor||anchor.hasAttribute('download')||(anchor.target&&anchor.target!=='_self'))return;
    const url=new URL(anchor.href,location.href);
    if(url.origin!==location.origin||url.pathname.startsWith('/api/')||(url.pathname===location.pathname&&url.search===location.search))return;
    if(!enabled()||!Element.prototype.animate)return;
    // Native cross-document transitions keep links immediate on supporting browsers.
    if('onpagereveal' in window&&document.startViewTransition)return;
    event.preventDefault();if(navigating)return;navigating=true;
    const version=++navigationVersion;
    document.querySelectorAll('dialog[open]').forEach(dialog=>dialog.close());
    document.body.classList.remove('sidebar-open');
    const menu=document.querySelector('[data-menu-toggle]'),side=document.querySelector('#side-nav');
    if(menu){menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Abrir navegação')}if(side)side.inert=true;
    root.removeAttribute('data-page-entry');root.dataset.navigating='';
    const layer=document.querySelector('.page-transition-layer'),page=document.querySelector('.page-wrapper');
    if(page)exitAnimations.push(page.animate([{opacity:1,transform:'none'},{opacity:0,transform:'translateY(-8px)'}],{duration:220,fill:'forwards',easing:'cubic-bezier(.4,0,.8,.3)'}));
    const commit=()=>{if(navigating&&version===navigationVersion){clearTimeout(timer);location.assign(url.href)}};
    // Wait for the painted exit, with a fallback if the browser suspends animation frames.
    Promise.all(exitAnimations.map(animation=>animation.finished)).then(commit,()=>{});
    timer=window.setTimeout(commit,500);
  });
})();
</script>
