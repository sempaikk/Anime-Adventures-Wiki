---
import { iconPaths } from '../lib/icons';
const { name = 'arrow', size = 20, ...attributes } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...attributes}><path d={iconPaths[name] || iconPaths.arrow}/></svg>
