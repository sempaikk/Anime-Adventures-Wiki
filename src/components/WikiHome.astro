---
import {aboutGame, sourcePatch, featuredUnits, homeSource} from '../lib/wiki-home';
import {channels, botInvite} from '../lib/community';
import {unitUrl, articles} from '../lib/wiki';
import {factValue} from '../lib/unit-tools.mjs';
import {gameNavigation} from '../lib/wiki-navigation';
import art from '../../source/interface-art.json';
import GameIcon from './GameIcon.astro';
const models = featuredUnits.filter(unit=>unit.image).slice(0,6).map(unit=>{
 const page=articles.find(page=>page.slug===unit.article);
 return {id:unit.id,name:unit.name,image:unit.image,rarity:unit.rarity||'Personagem',href:unitUrl(unit),cost:factValue(page||{},'Deployment Cost')||'Não informado',tower:factValue(page||{},'Tower Type')||'Não informado'};
});
const featured=models[0];
const scenes=[['spaceship','Alien Spaceship'],['city','Hero City'],['dungeon','Virtual Dungeon']];
const quick=gameNavigation.filter(item=>['codes','traits','relics'].includes(item.key));
---
<section class="nexus-hero" aria-labelledby="home-title" data-nexus-scene data-models={JSON.stringify(models)} data-scene-frames={JSON.stringify(scenes.map(([key,label])=>({label,image:art[key].image})))}>
 <div class="nexus-panorama" aria-hidden="true"><img data-nexus-backdrop src={art.spaceship.image} width="1023" height="575" alt="" fetchpriority="high"/><img data-nexus-backdrop-next src={art.spaceship.image} width="1023" height="575" alt=""/><div class="nexus-panorama-shade"></div></div>
 <div class="nexus-hero-top"><span class="nexus-section-id"><i aria-hidden="true"></i> WIKI E COMUNIDADE</span><div class="nexus-hero-options"><button type="button" class="nexus-sound-button" data-sound-toggle aria-pressed="false"><span class="sound-glyph" aria-hidden="true"></span><span data-sound-label>Ativar som</span></button><span class="nexus-divider" aria-hidden="true"></span><a href={channels[0].url} target="_blank" rel="noopener noreferrer">Jogar <i class="arrow-diagonal" aria-hidden="true"></i></a></div></div>
 <div class="nexus-hero-grid">
  <div class="nexus-intro"><span class="nexus-overline">PERSONAGENS · GUIAS · MECÂNICAS</span><h1 id="home-title">O JOGO<br/><span>POR</span><br/><strong>DENTRO.</strong></h1><p>Explore cada forma.<br/> Encontre a informação que muda seu jogo.</p>
   <form class="nexus-search" action="/biblioteca/" role="search" aria-label="Pesquisar no site" data-home-search><label class="sr-only" for="home-search">Pesquisar personagens e artigos</label><span class="search-mark" aria-hidden="true"></span><input id="home-search" name="q" type="search" placeholder="Qual personagem ou assunto?" autocomplete="off"/><button type="submit" aria-label="Pesquisar"><i class="arrow-diagonal" aria-hidden="true"></i></button></form>
   <div class="nexus-quick">{quick.map(item=><a href={item.href}><GameIcon item={item}/><span>{item.accessible}</span></a>)}</div>
   <a href="/personagens/" class="nexus-explore-link"><span>Explorar personagens</span><span class="nexus-link-track" aria-hidden="true"></span><i class="arrow-diagonal" aria-hidden="true"></i></a>
  </div>
  {featured&&<div class="nexus-stage-wrap">
   <div class="nexus-stage" data-stage tabindex="0" role="region" aria-label="Personagem em foco. Use as setas do teclado para mudar de personagem.">
    <canvas data-nexus-grid aria-hidden="true"></canvas><div class="nexus-floor" aria-hidden="true"></div><div class="nexus-stage-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div class="nexus-scan" aria-hidden="true"></div>
    <div class="nexus-stage-heading"><span>PERSONAGEM EM FOCO</span><span data-stage-rarity>{featured.rarity}</span></div>
    <div class="nexus-coordinate coordinate-left" aria-hidden="true"><span></span><span></span><span></span></div><div class="nexus-coordinate coordinate-right" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="nexus-portrait" data-stage-portrait><img data-stage-image src={featured.image} alt={featured.name} width="900" height="900" fetchpriority="high"/></div>
    <dl class="nexus-stage-facts"><div><dt>POSICIONAMENTO</dt><dd data-stage-tower>{featured.tower}</dd></div><div><dt>CUSTO INICIAL</dt><dd data-stage-cost>{featured.cost}</dd></div></dl>
    <div class="nexus-model-controls"><button type="button" data-model-prev aria-label="Personagem anterior"><span aria-hidden="true">←</span></button><span data-model-position>01 / {String(models.length).padStart(2,'0')}</span><button type="button" data-model-next aria-label="Próximo personagem"><span aria-hidden="true">→</span></button></div>
   </div>
   <div class="nexus-unit-identity"><span class="nexus-unit-bracket" aria-hidden="true"></span><div aria-live="polite" aria-atomic="true"><small>FORMA SELECIONADA</small><h2 data-stage-name>{featured.name}</h2></div><a href={featured.href} data-stage-link aria-label={`Abrir artigo de ${featured.name}`}><i class="arrow-diagonal" aria-hidden="true"></i></a></div>
   <div class="nexus-model-roster" role="group" aria-label="Escolher personagem em foco">{models.map((unit,index)=><button type="button" data-model-pick={index} aria-label={`Mostrar ${unit.name}`} aria-pressed={index===0}><img src={unit.image} alt="" width="80" height="80" loading="lazy"/><span>{String(index+1).padStart(2,'0')}</span></button>)}</div>
   <div class="nexus-unit-actions"><button type="button" data-stage-preview data-unit-preview={featured.id}>Ficha rápida <span class="plus-mark" aria-hidden="true"></span></button><button type="button" data-stage-compare data-compare={featured.id} aria-pressed="false">Comparar</button><a href={featured.href} data-stage-article>Consultar artigo <i class="arrow-diagonal" aria-hidden="true"></i></a></div>
  </div>}
 </div>
 <div class="nexus-hero-bottom"><div class="nexus-scene-playback"><span class="nexus-scene-marker" aria-hidden="true"></span><span data-scene-label>Alien Spaceship</span><button type="button" data-scene-toggle hidden>Pausar cenário</button></div><a href="#explorar" class="nexus-scroll">CONTINUAR <span class="arrow-up arrow-down" aria-hidden="true"></span></a></div>
</section>
<section class="nexus-destinations" id="explorar" aria-label="Explorar o site">
 <a class="nexus-destination nexus-destination-units" href="/personagens/" data-nexus-surface><img class="nexus-destination-scene" src={art.namak.image} alt="" width="1023" height="575" loading="lazy"/><div class="nexus-destination-top"><span>01 / CATÁLOGO</span><GameIcon item={gameNavigation[0]}/></div><div class="nexus-destination-copy"><span>ENCONTRE SUA PRÓXIMA CONSULTA</span><h2>Personagens<br/><strong>e suas formas.</strong></h2><p>Consulte atributos, evoluções e referências.</p></div>{models[1]&&<img class="nexus-destination-unit" src={models[1].image} alt="" width="900" height="900" loading="lazy"/>}<span class="nexus-destination-go">Abrir catálogo <i class="arrow-diagonal" aria-hidden="true"></i></span></a>
 <a class="nexus-destination nexus-destination-library" href="/biblioteca/" data-nexus-surface><img class="nexus-destination-scene" src={art.dungeon.image} alt="" width="1023" height="575" loading="lazy"/><div class="nexus-destination-top"><span>02 / BIBLIOTECA</span><GameIcon item={gameNavigation[1]}/></div><div class="nexus-destination-copy"><h2>O conhecimento<br/><strong>do jogo.</strong></h2><p>Itens, modos, mecânicas e guias.</p></div><span class="nexus-destination-go">Consultar a wiki <i class="arrow-diagonal" aria-hidden="true"></i></span></a>
 <a class="nexus-destination nexus-destination-people" href="/pessoas/" data-nexus-surface><img class="nexus-destination-scene" src={art.city.image} alt="" width="1023" height="575" loading="lazy"/><div class="nexus-destination-top"><span>03 / COMUNIDADE</span><span class="nexus-people-glyph" aria-hidden="true"></span></div><div class="nexus-destination-copy"><h2>Quem joga<br/><strong>também faz parte.</strong></h2><p>Perfis, dicas e comentários nos artigos.</p></div><span class="nexus-destination-go">Conhecer pessoas <i class="arrow-diagonal" aria-hidden="true"></i></span></a>
</section>
<section class="nexus-topics"><div class="nexus-section-heading"><div><span class="nexus-overline">CONSULTA DIRETA</span><h2>Escolha um assunto.</h2></div><a href="/biblioteca/">Todos os artigos <i class="arrow-diagonal" aria-hidden="true"></i></a></div><nav class="nexus-topic-grid" aria-label="Conteúdos do jogo">{gameNavigation.slice(0,6).map((item,index)=><a href={item.href} style={`--topic-color:${item.color}`} data-nexus-surface><small>{String(index+1).padStart(2,'0')}</small><GameIcon item={item}/><span>{item.accessible}</span><i class="arrow-diagonal" aria-hidden="true"></i></a>)}</nav><details class="nexus-more-topics"><summary>Mais conteúdos <span class="plus-mark" aria-hidden="true"></span></summary><nav class="nexus-topic-grid" aria-label="Mais conteúdos do jogo">{gameNavigation.slice(6).map((item,index)=><a href={item.href} style={`--topic-color:${item.color}`} data-nexus-surface><small>{String(index+7).padStart(2,'0')}</small><GameIcon item={item}/><span>{item.accessible}</span><i class="arrow-diagonal" aria-hidden="true"></i></a>)}</nav></details></section>
<section class="nexus-tools"><div><span class="nexus-overline">SUAS REFERÊNCIAS</span><h2>Compare.<br/><strong>Salve. Consulte.</strong></h2><p>Compare até três formas e mantenha seus artigos por perto. Entre com Discord para sincronizar os favoritos.</p></div><div class="nexus-tool-links"><a href="/comparar/"><span>01</span><strong>Comparar personagens</strong><i class="arrow-diagonal" aria-hidden="true"></i></a><a href="/favoritos/"><span>02</span><strong>Meus favoritos</strong><i class="arrow-diagonal" aria-hidden="true"></i></a><a href={botInvite} target="_blank" rel="noopener noreferrer"><span>03</span><strong>Adicionar o bot ao Discord</strong><i class="arrow-diagonal" aria-hidden="true"></i></a></div></section>
<details class="home-source nexus-source"><summary>Sobre o jogo e as fontes</summary><div class="home-source-body"><div><h2>Sobre o jogo</h2><div class="wiki-content" lang="en" set:html={aboutGame}/></div><div><h2>Informações da wiki</h2><p>Conteúdo adaptado da Anime Adventures Wiki. Cada artigo mantém seus créditos e a revisão consultada.</p><a class="text-link" href="/sobre/">Fontes e créditos <i class="arrow-diagonal" aria-hidden="true"></i></a><a class="text-link" href={`${homeSource.source_url}?oldid=${homeSource.revision_id}`} target="_blank" rel="noopener noreferrer">Página original <i class="arrow-diagonal" aria-hidden="true"></i></a><details><summary>Atualização histórica registrada na fonte</summary><h3>{sourcePatch.title}</h3><div class="wiki-content" lang="en" set:html={sourcePatch.html}/></details></div></div></details>
<script src="../scripts/nexus.ts"></script>
