---
import {aboutGame,sourcePatch,featuredUnits,homeSource} from '../lib/wiki-home';
import {channels,botInvite} from '../lib/community';
import {unitUrl, articleUrl} from '../lib/wiki';
import {gameNavigation} from '../lib/wiki-navigation';
import art from '../../source/interface-art.json';
const featured=featuredUnits.find(unit=>unit.name.includes('Sky Reaver'))||featuredUnits[0];
const scenes=[['spaceship','Alien Spaceship'],['city','Hero City'],['dungeon','Virtual Dungeon']];
---
<section class="orbit-hero" data-orbit-hero aria-labelledby="home-title">
  <div class="hero-world" aria-hidden="true"><img class="hero-world-image" src={art.spaceship.image} width="1023" height="575" alt="" fetchpriority="high"/><canvas data-scene-canvas></canvas><div class="world-shade"></div><div class="world-grid"></div></div>
  <div class="hero-copy"><span class="hero-kicker"><span aria-hidden="true"></span> CONSULTE A WIKI</span><h1 id="home-title">O JOGO<br/><span>EM DETALHES.</span></h1><p>Encontre uma unidade, compare seus atributos<br/>e salve os artigos que você usa.</p><div class="hero-actions"><a class="button button-primary" href="/personagens/">Ver personagens <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a><a class="hero-play" href={channels[0].url} target="_blank" rel="noopener noreferrer">Jogar no Roblox <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a></div></div>
  {featured&&<a class="hero-character" href={unitUrl(featured)} aria-label={`Consultar ${featured.name}`}><div class="hero-character-art"><img src={featured.image} alt={featured.name} width="900" height="900" fetchpriority="high"/></div><div class="character-label"><span>PERSONAGEM EM DESTAQUE</span><strong>{featured.name}</strong><small>Ver ficha completa <i class="arrow-diagonal" aria-hidden="true"></i></small></div></a>}
  <div class="hero-bottom"><div class="scene-controls" aria-label="Cenário da página inicial">{scenes.map(([key,label],i)=><button data-scene={key} data-scene-image={art[key].image} aria-pressed={i===0} aria-label={`Cenário: ${label}`}><span class="scene-index">0{i+1}</span><span>{label}</span></button>)}</div><a href="#explorar" class="hero-scroll">Explorar <span aria-hidden="true">↓</span></a></div>
</section>
<section class="home-portals" id="explorar" aria-label="Explorar o site">
 <a class="orbit-portal portal-units" href="/personagens/"><span class="portal-number">01 / CATÁLOGO</span><h2>Seu próximo<br/>personagem.</h2><p>Formas, atributos e evoluções.</p><span class="portal-action">Personagens <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></span>{featuredUnits[1]?.image&&<img src={featuredUnits[1].image} alt="" width="900" height="900" loading="lazy"/>}</a>
 <a class="orbit-portal portal-library" href="/biblioteca/"><img class="portal-backdrop" src={art.dungeon.image} alt="" width="1023" height="575" loading="lazy"/><span class="portal-number">02 / WIKI</span><h2>A informação<br/>que você procura.</h2><p>Itens, modos, guias e mecânicas.</p><span class="portal-action">Consultar a wiki <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></span></a>
 <a class="orbit-portal portal-people" href="/pessoas/"><img class="portal-backdrop" src={art.city.image} alt="" width="1023" height="575" loading="lazy"/><span class="portal-number">03 / COMUNIDADE</span><h2>O jogo continua<br/>na conversa.</h2><p>Perfis, dicas e comentários nos artigos.</p><span class="portal-action">Conhecer pessoas <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></span></a>
</section>
<section class="home-navigation" id="navegacao"><div class="section-heading"><div><span class="eyebrow">CONSULTA RÁPIDA</span><h2>Por onde começar?</h2></div><a href="/biblioteca/" class="text-link">Todos os artigos <i class="arrow-diagonal" aria-hidden="true"></i></a></div><div class="home-topic-links">{gameNavigation.slice(0,5).map(item=><a href={item.href}><span>{item.accessible}</span></a>)}</div><details class="more-topics"><summary>Mais conteúdos do jogo</summary><div class="home-topic-links">{gameNavigation.slice(5).map(item=><a href={item.href}>{item.accessible}</a>)}</div></details></section>
<section class="home-featured"><div class="section-heading"><div><span class="eyebrow">CATÁLOGO</span><h2>Conheça as unidades</h2></div><a class="text-link" href="/personagens/">Abrir catálogo <i class="arrow-diagonal" aria-hidden="true"></i></a></div><div class="featured-strip">{featuredUnits.slice(0,6).map(unit=><a href={unitUrl(unit)}><div>{unit.image?<img src={unit.image} alt="" width="300" height="300" loading="lazy"/>:<span>Retrato indisponível</span>}</div><small>{unit.rarity||'Personagem'}</small><h3>{unit.name}</h3></a>)}</div></section>
<section class="home-tools"><div><span class="eyebrow">SEU JOGO, SUAS REFERÊNCIAS</span><h2>Compare. Salve. Consulte.</h2><p>Compare até três personagens e guarde os artigos que você usa. Entre com Discord para levar seus favoritos para outros dispositivos.</p></div><div class="tool-link-stack"><a href="/comparar/">Comparar personagens <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a><a href="/favoritos/">Meus favoritos <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a><a href={botInvite} target="_blank" rel="noopener noreferrer">Adicionar o bot ao Discord <span aria-hidden="true"><i class="arrow-diagonal" aria-hidden="true"></i></span></a></div></section>
<details class="home-source"><summary>Sobre o jogo e as fontes</summary><div class="home-source-body"><div><h2>Sobre o jogo</h2><div class="wiki-content" lang="en" set:html={aboutGame}/></div><div><h2>Informações da wiki</h2><p>Conteúdo adaptado da Anime Adventures Wiki. A fonte pode conter informações antigas; cada artigo mantém seus créditos e a revisão consultada.</p><a class="text-link" href="/sobre/">Fontes e créditos <i class="arrow-diagonal" aria-hidden="true"></i></a><a class="text-link" href={`${homeSource.source_url}?oldid=${homeSource.revision_id}`} target="_blank" rel="noopener noreferrer">Página original <i class="arrow-diagonal" aria-hidden="true"></i></a><details><summary>Atualização histórica registrada na fonte</summary><h3>{sourcePatch.title}</h3><div class="wiki-content" lang="en" set:html={sourcePatch.html}/></details></div></div></details>
<script src="../scripts/orbit.ts"></script>
