---
import Layout from '../../layouts/Layout.astro';
import art from '../../../source/interface-art.json';
---
<Layout title="Comunidade — Adventures Wiki" active="pessoas">
<header class="community-hero"><img src={art.city.image} alt="" width="1023" height="575"/><div><span class="eyebrow">COMUNIDADE</span><h1>Quem joga<br/>também faz parte.</h1><p>Conheça os jogadores e acompanhe suas contribuições para a wiki.</p><a class="button button-primary" href="/conta/#perfil">Configurar meu perfil <span aria-hidden="true"><span class="ui-direction" aria-hidden="true">↗️</span></span></a></div><span class="scene-credit">Hero City · Imagem da wiki</span></header>
<section class="people-section" data-people><div class="section-heading"><h2>Pessoas</h2><a class="text-link" href="/comunidade/">Canais do jogo <span class="ui-direction" aria-hidden="true">↗️</span></a></div><form class="people-search" data-people-search role="search"><label class="sr-only" for="people-query">Pesquisar por nome ou identificador</label><input type="search" name="q" id="people-query" placeholder="Pesquisar pessoas…" maxlength="80"/><button class="button button-outline">Pesquisar</button></form><p class="community-status" data-people-status role="status">Carregando perfis…</p><div class="people-grid" data-people-grid></div><button class="button button-outline" data-people-more hidden>Ver mais pessoas</button></section>
<script src="../../scripts/profiles.ts"></script>
</Layout>
