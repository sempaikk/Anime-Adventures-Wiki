---
import Layout from '../../layouts/Layout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { units } from '../../lib/wiki';
const sorted=[...units].sort((a,b)=>a.name.localeCompare(b.name));
---
<Layout title="Personagens — Adventures Wiki" active="personagens">
<div class="page-heading"><span class="eyebrow">PERSONAGENS</span><span class="edition">CATÁLOGO DE UNIDADES</span></div>
<div class="catalog-heading"><div><h1>Personagens</h1><p>Pesquise uma unidade para consultar suas formas, estatísticas e evolução.</p></div><span class="catalog-count">{units.length}<small>FORMAS NO CATÁLOGO</small></span></div>
<section class="filter-panel" aria-label="Filtrar personagens"><div class="catalog-search"><label class="sr-only" for="unit-search">Nome do personagem</label><input id="unit-search" type="search" placeholder="Pesquisar personagens…" autocomplete="off"/><span aria-hidden="true">⌕</span></div><label>Raridade<select id="rarity-filter"><option value="">Todas as raridades</option>{['Rare','Epic','Legendary','Mythic','Secret','Exclusive'].map(r=><option value={r}>{r}</option>)}</select></label><label>Forma<select id="form-filter"><option value="">Todas as formas</option><option value="base">Forma base</option><option value="variant">Evoluções e variantes</option></select></label><label class="archive-filter"><input id="retired-filter" type="checkbox"/>Incluir arquivo histórico</label></section>
<div class="results-heading"><span id="unit-results" aria-live="polite"></span><button class="plain-button" id="clear-filters">Limpar filtros</button></div>
<div class="units-grid catalog-grid" id="unit-grid">{sorted.map((unit,index)=><UnitCard unit={unit} index={index}/>)}</div>
<div class="empty-state" id="unit-empty" hidden><h2>Nenhum personagem encontrado.</h2><p>Tente outro nome ou remova um dos filtros.</p></div><div class="load-more"><button class="button button-outline" id="load-units">Carregar mais personagens <span>↓</span></button></div>
</Layout>
