---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { units } from '../../lib/wiki';
const sorted=[...units].sort((a,b)=>a.name.localeCompare(b.name));
---
<Layout title="Personagens — Adventures Wiki" active="personagens">

<div class="catalog-heading"><div><h1>Personagens</h1><p>Pesquise uma unidade para consultar suas formas, estatísticas e evolução.</p></div><span class="catalog-count">{units.length}<small>FORMAS NO CATÁLOGO</small></span></div>
<section class="filter-panel catalog-tools" aria-label="Filtrar personagens"><div class="catalog-search"><label class="sr-only" for="unit-search">Nome do personagem</label><input id="unit-search" type="search" placeholder="Pesquisar por nome atual ou anterior…" autocomplete="off"/></div><details data-catalog-filters><summary><span>Filtros e ordenação <span data-filter-count></span></span></summary><div class="catalog-filter-fields"><label>Raridade<select id="rarity-filter"><option value="">Todas as raridades</option>{['Rare','Epic','Legendary','Mythic','Secret','Exclusive'].map(r=><option value={r}>{r}</option>)}</select></label><label>Posicionamento<select id="tower-filter"><option value="">Todos os tipos</option><option value="ground">Ground — solo</option><option value="hill">Hill — elevação</option><option value="hybrid">Hybrid — híbrido</option><option value="unknown">Não informado</option></select></label><label>Ordenar por<select id="unit-sort"><option value="name">Nome</option><option value="cost-asc">Menor custo de posicionamento</option><option value="cost-desc">Maior custo de posicionamento</option></select></label><label class="archive-filter"><input id="retired-filter" type="checkbox"/>Incluir arquivo histórico</label></div></details></section>
<div class="results-heading"><span id="unit-results" aria-live="polite"></span><div class="results-actions"><button class="plain-button share-filter-link" data-share-filters>Copiar busca</button><button class="plain-button" id="clear-filters">Limpar filtros</button></div></div><p class="tool-message filter-share-message" data-filter-message role="status"></p>
<div class="units-grid catalog-grid" id="unit-grid">{sorted.map((unit,index)=><UnitCard unit={unit} index={index}/>)}</div>
<div class="empty-state" id="unit-empty" hidden><h2>Nenhum personagem encontrado.</h2><p>Tente outro nome ou remova um dos filtros.</p></div><div class="load-more"><button class="button button-outline" id="load-units">Carregar mais personagens <span class="ui-emoji" aria-hidden="true"><Icon name="arrow"/></span></button></div>
</Layout>
