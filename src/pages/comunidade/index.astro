---
import Layout from '../../layouts/Layout.astro';
import CommunityFeed from '../../components/CommunityFeed.astro';
import Icon from '../../components/Icon.astro';
import art from '../../../source/interface-art.json';
---
<Layout title="Comunidade — Adventures Wiki" active="comunidade" description="Descobertas, conquistas e conversas dos jogadores de Anime Adventures.">
  <header class="future-community-heading"><div><span class="future-kicker"><span></span> A AVENTURA É MELHOR EM COMPANHIA</span><h1>Sua comunidade.<br/><em>Novas histórias.</em></h1><p>Descobertas, conquistas e conversas de quem joga Anime Adventures.</p></div><a class="button button-outline" href="/pessoas/">Encontrar jogadores <Icon name="people"/></a></header>
  <div class="social-layout"><CommunityFeed/><aside class="social-sidebar">
    <section class="social-side-card social-side-intro"><img src={art.city.image} alt="" width="1023" height="575"/><div><span class="future-kicker">SEU ESPAÇO NO JOGO</span><h2>Uma descoberta<br/>puxa outra.</h2><p>Compartilhe uma composição, mostre aquela evolução e conheça quem também está nessa aventura.</p><a class="future-text-link" href="/conta/#perfil">Meu perfil <Icon name="arrow"/></a></div></section>
    <section class="social-side-card" data-friend-list hidden><div class="social-side-heading"><Icon name="people"/><h2>Suas conexões</h2></div><p data-friends-status role="status"></p><div data-friends-items></div></section>
    <section class="social-side-card social-guidelines"><h2>Um bom lugar para jogar junto.</h2><p>Respeite os outros jogadores, dê crédito às descobertas e use a denúncia quando algo precisar de revisão.</p><a class="future-text-link" href="/biblioteca/">Consultar a wiki <Icon name="book"/></a></section>
    <details class="social-side-card" data-post-moderation hidden><summary>Revisar publicações denunciadas</summary><p data-reports-status role="status"></p><div data-reports-list></div></details>
  </aside></div>
</Layout>
