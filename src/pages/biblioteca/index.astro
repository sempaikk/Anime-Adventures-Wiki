---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { libraryArticles, kindLabels } from '../../lib/wiki';
const filters = [['','Todos'],['unit','Personagens'],['item','Itens'],['mode','Modos'],['mechanic','Mecânicas'],['tierlist','Tier lists'],['guide','Guias']];
---
<Layout title="Biblioteca — Adventures Wiki" active="biblioteca">

<div class="catalog-heading"><div><h1>Biblioteca</h1><p>Personagens, itens, modos e mecânicas. Busque pelo nome atual ou por um nome anterior do jogo.</p></div><span class="catalog-count">{libraryArticles.length}<small>ARTIGOS</small></span></div>
<section class="filter-panel library-filters"><label class="sr-only" for="article-search">Pesquisar artigos</label><input id="article-search" type="search" placeholder="Pesquisar artigos…"/><div class="library-categories" aria-label="Tipo de artigo">{filters.map(([key,label])=><button data-article-kind={key} aria-pressed={key===''}>{label}</button>)}</div><label class="archive-filter library-archive"><input id="library-retired" type="checkbox"/> Incluir formas retiradas do catálogo ativo</label></section>
<div class="results-heading"><span id="article-results" aria-live="polite"></span><div class="results-actions"><button class="plain-button share-filter-link" data-share-filters>Copiar busca</button><button class="plain-button" id="clear-library-filters">Limpar filtros</button></div></div><p class="tool-message filter-share-message" data-filter-message role="status"></p>
<div class="library-grid" id="article-grid">{libraryArticles.map(page=><a class:list={['library-card',{'library-card--text':!page.thumbnail&&page.kind!=='unit'}]} href={`/artigo/${page.slug}/`} data-title={[page.title,page.excerpt,...(page.aliases||[])].join(' ').toLowerCase()} data-kind={page.kind} data-retired={String(page.retired)}>
{page.thumbnail ? <div class="library-thumbnail"><img src={page.thumbnail} alt="" loading="lazy" decoding="async" width="96" height="96"/></div> : page.kind==='unit' ? <div class="library-thumbnail library-thumbnail--empty" title="Não há um retrato disponível para esta forma na fonte."><span>Sem<br/>retrato</span></div> : null}
<div class="library-card-copy"><span class="eyebrow">{page.retired?'Arquivo histórico':kindLabels[page.kind]}</span><h2>{page.title}</h2><p>{page.excerpt}</p></div><span class="library-arrow" aria-hidden="true"><span class="ui-direction" aria-hidden="true"><Icon name="external"/></span></span></a>)}</div>
<div class="empty-state" id="article-empty" hidden><h2>Nenhum artigo encontrado.</h2><p>Tente o nome anterior do personagem ou um termo mais curto.</p></div><div class="load-more"><button class="button button-outline" id="load-articles">Ver mais artigos <span class="ui-emoji" aria-hidden="true"><Icon name="arrow"/></span></button></div>
</Layout>
