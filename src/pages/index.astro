---
import Layout from '../layouts/Layout.astro';
import ExploreTiles from '../components/ExploreTiles.astro';
---
<Layout>
<section class="hub-intro" aria-labelledby="hub-title">
  <div class="hub-cover" aria-hidden="true"><img src="/art/official/roblox-cover.png" alt="" width="768" height="431" fetchpriority="high"/></div>
  <div class="hub-intro-copy">
    <span class="eyebrow">WIKI DA COMUNIDADE</span>
    <h1 id="hub-title">Anime Adventures</h1>
    <p class="hub-description">Consulte personagens, itens e guias do jogo. Pesquise pelo nome ou escolha uma categoria.</p>
    <form action="/biblioteca/" class="hub-search" role="search"><label class="sr-only" for="hub-query">Pesquisar na wiki</label><span class="search-mark" aria-hidden="true"></span><input id="hub-query" name="q" type="search" placeholder="Personagens, itens, guias…" autocomplete="off"/><button type="submit" aria-label="Buscar na wiki">→</button></form>
  </div>
  <span class="hub-cover-label">ARTE DO JOGO / GOMU</span>
</section>
<section class="home-categories" aria-labelledby="categories-title"><div class="home-section-heading"><h2 id="categories-title">Categorias</h2><a class="text-link" href="/biblioteca/">Ver todos os artigos <i class="arrow-diagonal" aria-hidden="true"></i></a></div><ExploreTiles/></section>
<div class="home-shortcuts">
  <a href="/favoritos/" class="home-shortcut"><div><h2>Seus favoritos</h2><p>Acesse os personagens e artigos que você salvou.</p></div><i class="arrow-diagonal" aria-hidden="true"></i></a>
  <a href="/comunidade/" class="home-shortcut"><div><h2>Jogo e comunidade</h2><p>Jogue no Roblox, veja os canais oficiais e adicione o bot.</p></div><i class="arrow-diagonal" aria-hidden="true"></i></a>
</div>
</Layout>
