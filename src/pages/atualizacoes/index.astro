---
import Layout from '../../layouts/Layout.astro';
type UpdateEntry = { date: string; title: string; items: string[]; note?: string };
// Public release notes will begin with the trailers. Keep both histories empty until then.
const site: UpdateEntry[] = [];
const bot: UpdateEntry[] = [];
const timelines = [{kind:'site',entries:site},{kind:'bot',entries:bot}];
const dateLabel=(date:string)=>new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z')).toUpperCase();
---
<Layout title="Atualizações do site e do bot — Adventures Wiki" active="updates"><div class="catalog-heading"><div><h1>Atualizações</h1><p>Acompanhe o que mudou na experiência do site e nos recursos do bot.</p></div></div>
<div class="update-tabs segmented" role="tablist" aria-label="Histórico de atualizações"><button id="tab-site" role="tab" aria-selected="true" aria-controls="updates-site" tabindex="0" data-update-tab="site">Atualizações do site</button><button id="tab-bot" role="tab" aria-selected="false" aria-controls="updates-bot" tabindex="-1" data-update-tab="bot">Atualizações do bot</button></div>
{timelines.map(({kind,entries})=><section id={`updates-${kind}`} role="tabpanel" aria-labelledby={`tab-${kind}`} hidden={kind!=='site'} class="update-timeline">{entries.length===0&&<p class="empty-social">Ainda não há atualizações publicadas.</p>}{entries.map(entry=><article class="update-entry"><div class="update-meta"><time datetime={entry.date}>{dateLabel(entry.date)}</time></div><div class="update-body"><h2>{entry.title}</h2><ul>{entry.items.map(item=><li>{item}</li>)}</ul>{entry.note&&<p class="update-note">{entry.note}</p>}</div></article>)}</section>)}
</Layout>
