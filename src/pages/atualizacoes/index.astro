---
import Layout from '../../layouts/Layout.astro';
const site=[{date:"2026-10-23",title:"Formato da wiki original em site próprio",items:["Cabeçalho com o logo e a arte do jogo, navegação horizontal e cores baseadas na wiki de origem.","Os 13 atalhos da página original usam seus ícones e cores, com os artigos disponíveis na própria hospedagem.","Página inicial com as seções e informações da fonte, incluindo o registro de atualização identificado como histórico.","Artigos com seções visíveis e a ficha original de informações ao lado do conteúdo.","Adaptação para celular, temas, busca, favoritos e ferramentas de comparação mantidos."],note:"As revisões da fonte continuam identificadas. Informações antigas não são apresentadas como novidades do jogo."},{date:"2026-10-23",title:"Comparador e organização da coleção",items:["Comparação de até três formas, com custos, tipos e fontes da revisão consultada.","Seleção pelo catálogo e pelas fichas, com link para compartilhar a comparação.","Filtros recolhidos, ordenação por custo e buscas compartilháveis no catálogo e na biblioteca.","Favoritos com busca, filtro, ordenação e remoção direta; atualização entre abas.","Nova ilustração original na página inicial, criada com IA e otimizada para cada tamanho de tela."],note:"Os retratos de personagens e as imagens dos artigos continuam usando suas fontes do jogo e da wiki."},{date:"2026-10-23",title:"Página inicial simplificada e novas transições",items:["Página inicial centrada na busca e nas categorias, com detalhes disponíveis ao abrir cada seção.","Textos da interface revisados para usar português direto.","Menus agrupados por função, com ícones consistentes nos atalhos do jogo.","Transições entre páginas, animações de fichas e abertura de seções, respeitando movimento reduzido."],note:"As transições entre páginas usam os recursos disponíveis no navegador."},{date:"2026-10-23",title:"Temas e navegação visual",items:["Página inicial com categorias, personagens, guias e canais da comunidade.","Tema Adventures inspirado nas artes do jogo, com opções Escuro e Claro.","Atalhos com ícones clicáveis, navegação inferior no celular e busca em destaque.","Fichas rápidas de personagens com dados e favoritos, incluindo formas sem artigo.","Consulta por etapa de upgrade nas estatísticas, preservando níveis e bônus da fonte.","Roblox, YouTube e Discord do jogo reunidos em uma área de comunidade."],note:"Os destaques exibidos são conteúdos da wiki. O chat integrado ao site e a IA fazem parte das próximas etapas."},{date:"2026-10-23",title:"Novo endereço do site",items:["Endereço da wiki atualizado para www.adventureswiki.workers.dev."]},{date:"2026-10-23",title:"Revisão da interface e dos artigos",items:["Nova identidade Adventures Wiki, com a arte de lançamento do jogo no cabeçalho e no ícone do site.","Superfícies em preto e branco com iluminação ao passar o mouse, transições e adaptação para quem prefere menos movimento.","Biblioteca reorganizada por tipo de conteúdo, com retratos reais, busca por nomes antigos e filtro de formas retiradas.","Artigos reconstruídos com galerias alinhadas, abas acessíveis, tabelas com busca e descrições expansíveis.","Imagens dos artigos disponíveis na própria hospedagem e animações carregadas somente quando solicitadas.","Avisos claros para retratos ausentes e páginas técnicas separadas do catálogo de jogo."],note:"Site publicado na Cloudflare; a leitura e os favoritos locais continuam disponíveis sem conta."},{date:"2026-10-23",title:"Importação dos artigos e mapa do lobby",items:["Apresentações dos 661 artigos importadas, com conferência de revisão e preservação do texto original.","Mapa navegável do lobby, com locais, descrições e controles de zoom.","Melhorias na busca por teclado, na navegação do celular e na leitura dos textos.","Avisos compreensíveis quando a própria fonte tem dados ausentes."],note:"A conferência visual e de conteúdo continua durante a prévia."},{date:'2026-10-23',title:'Primeira publicação do site',items:['Identidade visual própria com temas claro e escuro em preto e branco.','Navegação adaptada para computador e celular, com artes e ícones do jogo.','Catálogo de personagens com busca, raridade e filtros de formas.','Biblioteca com artigos no idioma original, fontes e revisões preservadas.','Favoritos salvos no navegador e busca global por artigos.','Convite permanente do bot e histórico separado de atualizações.'],note:'Em desenvolvimento. O conteúdo importado continua em conferência.'}];
const bot=[{date:'2026-10-23',title:'Adicionar ao Discord ficou mais simples.',items:['Parâmetros de instalação corrigidos para incluir o bot e seus comandos.','Convite permanente com as permissões usadas pelos recursos, sem exigir Administrador.','Instalação mantida apenas em servidores.']},{date:'2026-10-23',title:'Propostas coerentes com a classificação atual.',items:['Respostas da IA são descartadas quando a classificação do modo avaliado muda durante a consulta.','Controles privados reorganizados por conexão, participação, moderação local e administração da rede.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/8d8cd65a0f229be4caeb0632f691aafe0e981977'},{date:'2026-10-23',title:'Os dois modos, lado a lado.',items:['Tier list horizontal: Casual à esquerda e Infinite à direita, com categorias alinhadas e altura automática.','Revisão privada de denúncias com motivo e histórico de decisões.','Proteção temporária contra rajadas, melhorias na fila e acompanhamento privado para o dono.','Ícones ativos revisados para usar artes do jogo.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/394986c4181f655cefaf620d535e1af435da0107'},{date:'2026-10-23',title:'Mais conversa, menos avisos no canal.',items:['Convite de participação do chat global enviado em particular, com alternativa pelo comando.','Cópias com nome de exibição e uma única etiqueta Owner ou Tester quando aplicável.','Controles de participação privados e remoção seletiva dos avisos públicos antigos.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/1935b52ce8c3ae2ed0d56eb00422c249a692f8b5'}];
const dateLabel=(date:string)=>new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z')).toUpperCase();
---
<Layout title="Atualizações do site e do bot — Adventures Wiki" active="updates"><div class="page-heading"><span class="eyebrow">ARQUIVO / ATUALIZAÇÕES</span><span class="edition">SITE E BOT</span></div><div class="catalog-heading"><div><h1>Atualizações</h1><p>Acompanhe o que mudou na experiência do site e nos recursos do bot.</p></div></div>
<div class="update-tabs segmented" role="tablist" aria-label="Histórico de atualizações"><button id="tab-site" role="tab" aria-selected="true" aria-controls="updates-site" tabindex="0" data-update-tab="site">Atualizações do site</button><button id="tab-bot" role="tab" aria-selected="false" aria-controls="updates-bot" tabindex="-1" data-update-tab="bot">Atualizações do bot</button></div>
{[['site',site],['bot',bot]].map(([kind,entries])=><section id={`updates-${kind}`} role="tabpanel" aria-labelledby={`tab-${kind}`} hidden={kind!=='site'} class="update-timeline">{entries.map(entry=><article class="update-entry"><div class="update-meta"><time datetime={entry.date}>{dateLabel(entry.date)}</time></div><div class="update-body"><h2>{entry.title}</h2><ul>{entry.items.map(item=><li>{item}</li>)}</ul>{entry.note&&<p class="update-note">{entry.note}</p>}{entry.source&&<a href={entry.source} target="_blank" rel="noopener noreferrer" class="text-link">Registro da alteração <span><i class="arrow-diagonal" aria-hidden="true"></i></span></a>}</div></article>)}</section>)}
</Layout>
