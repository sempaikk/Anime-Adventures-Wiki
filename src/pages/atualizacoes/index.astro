---
import Layout from '../../layouts/Layout.astro';
const site=[{date:"2026-10-24",title:"Navegação, personagens e leitura revisados",items:["Painéis e controles arredondados, com composição revisada para celular e computador.","Ficha do personagem integrada à rolagem da página e títulos com alinhamento corrigido.","Raridades conferidas por identidade nos dados da fonte, incluindo Vengeful Swordsman.","Sons habilitados na primeira visita, com início após interação e preferência de silêncio preservada.","Barras de rolagem personalizadas e transições mais curtas entre páginas."]},{date:"2026-10-24",title:"Nova experiência visual e sonora",items:["Abertura com cena interativa, escolha de personagens e dados reais de cada forma.","Grade em perspectiva, varredura luminosa, profundidade e transições de painéis entre páginas.","Sons próprios da interface, com ativação opcional, controle de volume e preferência salva.","Navegação lateral no computador e nova linguagem visual em catálogos, artigos, perfis e ferramentas.","Correção geral das imagens duplicadas pelo carregamento alternativo da fonte."]},{date:"2026-10-24",title:"Navegação e leitura revisadas",items:["Barra de leitura contida em 2 pixels, sem o brilho embaçado na primeira rolagem.","Busca direta na página inicial, ficha de destaque e atalhos com os ícones da wiki.","Navegação fixa para personagens, wiki, comunidade e favoritos no celular.","Índice acessível durante a leitura, indicação da seção atual e cópia de links do artigo ou de uma seção.","Revisão dos três temas, dos cartões e das áreas de toque."]},{date:"2026-10-24",title:"Reformulação do site",items:["Nova interface com cenários e retratos da wiki, transições e adaptação para celular.","Cenários em rotação, iluminação e bordas animadas, efeitos ao mouse e ao clique e controle de movimento em Aparência.","Perfis públicos opcionais com nome, biografia, capa, avatar e favoritos por escolha do jogador.","Comentários nos artigos com respostas, imagens, edição e exclusão pelo autor.","Área de revisão para sugestões de correção, denúncias e notas com fonte.","Busca, comparação de personagens e favoritos sincronizados com Discord.","Revisão dos alinhamentos, dos cartões, das imagens e dos controles de navegação."],note:"Publicações no perfil, amigos, mensagens e chat integrado serão adicionados em etapas futuras."}];
const bot=[{date:'2026-10-23',title:'Adicionar ao Discord ficou mais simples.',items:['Parâmetros de instalação corrigidos para incluir o bot e seus comandos.','Convite permanente com as permissões usadas pelos recursos, sem exigir Administrador.','Instalação mantida apenas em servidores.']},{date:'2026-10-23',title:'Propostas coerentes com a classificação atual.',items:['Respostas da IA são descartadas quando a classificação do modo avaliado muda durante a consulta.','Controles privados reorganizados por conexão, participação, moderação local e administração da rede.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/8d8cd65a0f229be4caeb0632f691aafe0e981977'},{date:'2026-10-23',title:'Os dois modos, lado a lado.',items:['Tier list horizontal: Casual à esquerda e Infinite à direita, com categorias alinhadas e altura automática.','Revisão privada de denúncias com motivo e histórico de decisões.','Proteção temporária contra rajadas, melhorias na fila e acompanhamento privado para o dono.','Ícones ativos revisados para usar artes do jogo.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/394986c4181f655cefaf620d535e1af435da0107'},{date:'2026-10-23',title:'Mais conversa, menos avisos no canal.',items:['Convite de participação do chat global enviado em particular, com alternativa pelo comando.','Cópias com nome de exibição e uma única etiqueta Owner ou Tester quando aplicável.','Controles de participação privados e remoção seletiva dos avisos públicos antigos.'],source:'https://github.com/sempaikk/Anime-Adventures/commit/1935b52ce8c3ae2ed0d56eb00422c249a692f8b5'}];
const dateLabel=(date:string)=>new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z')).toUpperCase();
---
<Layout title="Atualizações do site e do bot — Adventures Wiki" active="updates"><div class="page-heading"><span class="eyebrow">ARQUIVO / ATUALIZAÇÕES</span><span class="edition">SITE E BOT</span></div><div class="catalog-heading"><div><h1>Atualizações</h1><p>Acompanhe o que mudou na experiência do site e nos recursos do bot.</p></div></div>
<div class="update-tabs segmented" role="tablist" aria-label="Histórico de atualizações"><button id="tab-site" role="tab" aria-selected="true" aria-controls="updates-site" tabindex="0" data-update-tab="site">Atualizações do site</button><button id="tab-bot" role="tab" aria-selected="false" aria-controls="updates-bot" tabindex="-1" data-update-tab="bot">Atualizações do bot</button></div>
{[['site',site],['bot',bot]].map(([kind,entries])=><section id={`updates-${kind}`} role="tabpanel" aria-labelledby={`tab-${kind}`} hidden={kind!=='site'} class="update-timeline">{entries.map(entry=><article class="update-entry"><div class="update-meta"><time datetime={entry.date}>{dateLabel(entry.date)}</time></div><div class="update-body"><h2>{entry.title}</h2><ul>{entry.items.map(item=><li>{item}</li>)}</ul>{entry.note&&<p class="update-note">{entry.note}</p>}</div></article>)}</section>)}
</Layout>
