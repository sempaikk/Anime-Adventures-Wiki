---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import WikiHome from '../../components/WikiHome.astro';
import ArticleDiscussion from '../../components/ArticleDiscussion.astro';
import CommunityFeed from '../../components/CommunityFeed.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import { articles, units, renderArticle, metadata, unitUrl, kindLabels } from '../../lib/wiki';
import { factLabel, factValue } from '../../lib/unit-tools.mjs';
import { splitPrimaryInfobox } from '../../lib/wiki-presentation.mjs';
export function getStaticPaths(){return articles.map(page=>({params:{slug:page.slug},props:{page}}))}
const { page } = Astro.props;
const isWikiHome=page.title==='Anime Adventures Wiki';
const content=page.editorial?{html:'',sections:[],ready:true,sourceError:false}:renderArticle(page), source=metadata(page);
const unit=units.find(u=>u.id===page.unit_id);
const parts=unit&&!page.empty?splitPrimaryInfobox(content.html):{html:content.html,infobox:''};
const related=unit ? units.filter(u=>u.id!==unit.id && u.name.split(' (')[0]===unit.name.split(' (')[0]) : [];
const aliases=unit?.aliases.filter(name=>name.toLowerCase()!==unit.name.toLowerCase())||[];
---
<Layout title={`${page.title} — Adventures Wiki`} description={page.excerpt} active={isWikiHome?'inicio':unit?'personagens':'biblioteca'} home={isWikiHome} noindex={!!(page.editorial || page.empty || isWikiHome || page.canonical_slug!==page.slug)} canonical={isWikiHome?'/':`/artigo/${page.canonical_slug||page.slug}/`} image={unit?.image||page.thumbnail}>
{isWikiHome?<WikiHome/>:<>
<div class="page-heading"><nav class="breadcrumbs" aria-label="Caminho"><a href="/">Início</a><span>/</span><a href={unit?'/personagens/':'/biblioteca/'}>{unit?'Personagens':'Biblioteca'}</a><span>/</span><span>{page.title}</span></nav></div>
<header class="classic-article-heading"><div class="article-title"><div><span class="eyebrow">{unit?(unit.rarity||'Personagem'):kindLabels[page.kind]}</span><h1>{page.title}</h1></div></div>{aliases.length>0&&<p class="article-aliases"><strong>Também conhecido como:</strong> {aliases.join(' · ')}</p>}<div class="classic-article-actions"><button type="button" class="button button-outline" data-favorite={page.canonical_slug || page.slug} aria-pressed="false">Salvar nos favoritos ＋</button>{unit&&<button type="button" class="button button-outline" data-compare={unit.id} aria-pressed="false">Comparar</button>}</div><a class="article-source-link" href="#article-provenance"><Icon name="book" size={15}/>Fonte comunitária · <span>Revisão</span> <time datetime={page.revision_timestamp} data-revision-date>{new Date(page.revision_timestamp).toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time></a></header>
{unit?.retired && <aside class="notice">Arquivo histórico: esta forma foi marcada como retirada do catálogo ativo do jogo.</aside>}
{unit?.image_note && <p class="portrait-provenance">{unit.image_note} <a href={unit.image_source} target="_blank" rel="noopener noreferrer">Ver imagem na fonte</a>.</p>}
{content.sourceError && !page.editorial && <aside class="notice">Alguns dados desta página não estão disponíveis na fonte original. As informações existentes foram preservadas; consulte os créditos ao final para conferir a origem.</aside>}
{!page.editorial&&<><div class="article-reading-tools" data-article-tools>
{content.sections.length>0?<details class="reading-index"><summary>Índice do artigo</summary><nav class="reading-index-panel" aria-label="Seções do artigo">{content.sections.map(s=><a href={`#${s.anchor}`}>{s.line.replace(/<[^>]+>/g,'')}</a>)}</nav></details>:<a href="#informacoes">Informações</a>}
<span class="reading-current" data-reading-current>Informações</span><a href="#comentarios">Comentários</a><button type="button" data-share-article>Copiar link</button></div><EditorialNotes article={page.canonical_slug||page.slug}/></>}
<div id="informacoes" class:list={['article-layout',`article-kind-${page.kind}`,{'article-layout--wide':!content.sections.length&&!related.length&&!unit}]}><article class="wiki-content" lang="en">
{page.editorial ? <div class="empty-state"><h2>Página técnica da fonte.</h2><p>Este endereço corresponde a um teste de edição ou modelo da Wiki original. Ele está preservado no arquivo de fontes e não é apresentado como guia do jogo.</p><a class="button button-outline" href="/biblioteca/">Explorar os artigos do jogo</a></div> : page.empty ? <div class="empty-state"><h2>{page.canonical_slug!==page.slug?'Esta forma tem um artigo atualizado.':'Esta página ainda não tem conteúdo na fonte.'}</h2><p>{page.canonical_slug!==page.slug?`As informações de ${unit?.name} estão reunidas no artigo atual.`:'A revisão coletada não contém informações suficientes para apresentar.'}</p>{page.canonical_slug!==page.slug&&<a class="button button-primary" href={`/artigo/${page.canonical_slug}/`}>Abrir artigo atual <span><Icon name="arrow"/></span></a>}</div> : content.ready ? <Fragment set:html={parts.html}/> : <div class="empty-state"><h2>Artigo temporariamente indisponível.</h2><p>A apresentação deste conteúdo está sendo revisada. Você pode consultar outros artigos na Biblioteca.</p><a class="button button-outline" href="/biblioteca/">Voltar à Biblioteca</a></div>}
</article><aside class="article-aside">{parts.infobox?<div class="original-infobox wiki-content" lang="en" set:html={parts.infobox}/>:unit&&<div class="classic-fallback-infobox">{unit.image?<img src={unit.image} alt={unit.name} width="280" height="280"/>:<p class="portrait-unavailable">Retrato ainda indisponível para esta forma.</p>}{page.facts?.length>0&&<dl class="unit-facts">{page.facts.map(fact=><div><dt>{factLabel(fact.label)}</dt><dd>{factValue(page,fact.label)||'Não informado'}</dd></div>)}</dl>}</div>}{content.sections.length>0 && <details class="article-index" open><summary>Neste artigo</summary><nav class="table-of-contents" aria-label="Neste artigo">{content.sections.map(s=><a href={`#${s.anchor}`} class={`level-${s.toclevel}`}>{s.line.replace(/<[^>]+>/g,'')}</a>)}</nav></details>}{related.length>0&&<div class="related-forms"><span class="nav-label">OUTRAS FORMAS</span>{related.map(u=><a href={unitUrl(u)}>{u.image&&<img src={u.image} alt=""/>}{u.name}<span><span class="ui-direction" aria-hidden="true"><Icon name="arrow"/></span></span></a>)}</div>}</aside></div>
<details class="source-details" id="article-provenance"><summary>Fonte, revisão e créditos</summary><p>Texto adaptado na apresentação a partir da <a href={source.url} target="_blank" rel="noopener noreferrer">Anime Adventures Wiki — revisão {source.revision}</a>, sob <a href="https://www.fandom.com/licensing">CC-BY-SA</a>. <a href={source.history}>Ver histórico e colaboradores</a>. Imagens mantêm seus créditos e condições de uso na fonte original.</p><p>A data da revisão é <time datetime={page.revision_timestamp} data-revision-date>{new Date(page.revision_timestamp).toLocaleDateString('pt-BR')}</time>; ela não corresponde necessariamente à data de uma atualização do jogo. Esta é uma fonte comunitária e pode conter lacunas.</p></details>
{!page.editorial&&<><ArticleDiscussion article={page.canonical_slug||page.slug}/><section class="article-topic-panel" id="article-community"><h2>Na comunidade</h2><p>Publicações relacionadas a este artigo.</p><CommunityFeed compact article={page.canonical_slug||page.slug}/><a class="future-text-link" href={`/comunidade/?artigo=${page.canonical_slug||page.slug}`}>Publicar sobre este artigo <Icon name="arrow"/></a></section></>}
</>}
</Layout>
