{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime-adventures-wiki",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
}
