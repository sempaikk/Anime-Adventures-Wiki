{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "worker/coming-soon.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "triggers": { "crons": [] },
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } },
    { "name": "MEDIA_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adventures-wiki",
      "database_id": "c55a4bed-ce77-4c48-8b2d-62bd7196ec7c",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://www.adventureswiki.workers.dev",
    "DISCORD_CLIENT_ID": "1561527465657114644",
    "COMMUNITY_ADMIN_IDS": "1401930158348177438",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
}
