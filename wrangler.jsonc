{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adventures-wiki",
      "database_id": "c55a4bed-ce77-4c48-8b2d-62bd7196ec7c",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://www.adventureswiki.workers.dev",
    "DISCORD_CLIENT_ID": "1561527465657114644",
    "COMMUNITY_ADMIN_IDS": "1401930158348177438",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/404.html", "/artigo/*", "/personagem/*", "/personagens/*", "/biblioteca/*", "/atualizacoes/*", "/comparar/*", "/comunidade/*", "/conta/*", "/favoritos/*", "/mapa/*", "/perfil/*", "/pessoas/*", "/revisao/*", "/sobre/*", "/pt-br/perfil/*", "/en-us/perfil/*"],
  },
  "observability": { "enabled": true },
}
